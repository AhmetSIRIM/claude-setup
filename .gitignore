# never commit real secrets; settings.template.json holds placeholders only
settings.json
*.local.json
# CI and each machine install these from the lockfile
.github/node_modules/
tools/node_modules/

# skills/ is allowlisted: locally linked skills never ship by accident
skills/*
!skills/opencode-delegate/
!skills/learn/

# IDE state (JetBrains); nothing in it is part of the setup
.idea/

# go build ./cmd/<name> drops its binary here when run from the repository root
/budget-check
